{
  "name": "larena/update-client",
  "description": "Larena Update Client: installed-site trust, planning, preflight, execution, rollback and retry boundary for Larena updates.",
  "type": "library",
  "license": "Apache-2.0",
  "authors": [
    {
      "name": "Rim Zabarov",
      "homepage": "https://github.com/zabarov",
      "role": "Author"
    }
  ],
  "require": {
    "php": "^8.3",
    "larena/access": "dev-main",
    "larena/core": "dev-main",
    "larena/filesystem": "dev-main",
    "larena/licensing": "dev-main"
  },
  "autoload": {
    "psr-4": {
      "Larena\\UpdateClient\\": "src/"
    }
  },
  "autoload-dev": {
    "psr-4": {
      "Larena\\UpdateClient\\Tests\\": "tests/"
    }
  },
  "require-dev": {
    "phpstan/phpstan": "^2.0"
  },
  "repositories": [
    {
      "type": "path",
      "url": "../larena-workspace/packages/access",
      "options": {"symlink": true}
    },
    {
      "type": "path",
      "url": "../larena-workspace/packages/core",
      "options": {"symlink": true}
    },
    {
      "type": "path",
      "url": "../larena-workspace/packages/filesystem",
      "options": {"symlink": true}
    },
    {
      "type": "path",
      "url": "../larena-workspace/packages/licensing",
      "options": {"symlink": true}
    },
    {
      "type": "path",
      "url": "../larena-workspace/packages/audit",
      "options": {"symlink": true}
    },
    {
      "type": "path",
      "url": "../larena-workspace/packages/ui",
      "options": {"symlink": true}
    },
    {
      "type": "path",
      "url": "../larena-workspace/packages/dataview",
      "options": {"symlink": true}
    },
    {
      "type": "path",
      "url": "../larena-workspace/packages/layout",
      "options": {"symlink": true}
    }
  ],
  "scripts": {
    "test": "php scripts/test-placeholder.php",
    "test:unit": "php scripts/test-placeholder.php",
    "lint": "php scripts/lint.php",
    "analyse": "php scripts/analyse.php",
    "validate:larena": "php scripts/validate-larena-package.php",
    "evidence:check": "php scripts/check-evidence.php",
    "scope:check": "php tools/larena-scope-check.php",
    "quality:gate": [
      "@validate:larena",
      "@lint",
      "@analyse",
      "@test",
      "@evidence:check",
      "@scope:check"
    ]
  },
  "config": {
    "sort-packages": true,
    "platform": {
      "php": "8.3.31"
    },
    "allow-plugins": {}
  },
  "minimum-stability": "dev",
  "prefer-stable": true
}
